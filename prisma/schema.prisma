// ROXIE HUB Prisma Schema
// Database Engine: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum IdeaStatus {
  IDEA
  PLANNING
  SCRIPTING
  PRODUCTION
  PUBLISHED
  ARCHIVED
}

enum IdeaCategory {
  MM2
  FUNNY
  STORY
  TREND
  SHORT
  LONG_VIDEO
  OTHER
}

enum VideoPlatform {
  YOUTUBE
  YOUTUBE_SHORTS
  TIKTOK
  ROBLOX_EXPERIENCE
}

enum VideoStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CharacterRole {
  MAIN
  SUPPORTING
  VILLAIN
  NPC
  SPECIAL_GUEST
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  creatorTag    String?     @unique
  avatarUrl     String?
  bio           String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ideas         Idea[]
  videos        Video[]
  scripts       Script[]
  characters    Character[]
  calendarEvents CalendarEvent[]
  settings      UserSettings?
}

model Idea {
  id          String        @id @default(cuid())
  userId      String
  title       String
  description String?
  category    IdeaCategory  @default(OTHER)
  status      IdeaStatus    @default(IDEA)
  tags        String[]
  estimatedViews Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scripts     Script[]
  videos      Video[]
}

model Video {
  id              String        @id @default(cuid())
  userId          String
  ideaId          String?
  title           String
  description     String?
  thumbnail       String?
  platform        VideoPlatform @default(YOUTUBE)
  status          VideoStatus   @default(DRAFT)
  views           Int           @default(0)
  likes           Int           @default(0)
  comments        Int           @default(0)
  durationSeconds Int           @default(0)
  publicationDate DateTime?
  tags            String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea            Idea?         @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  calendarEvents  CalendarEvent[]
}

model Script {
  id                String       @id @default(cuid())
  userId            String
  ideaId            String?
  title             String
  hook              String?
  estimatedDuration Int          @default(0) // seconds
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea              Idea?        @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  scenes            Scene[]
  characters        ScriptCharacter[]
}

model Scene {
  id          String    @id @default(cuid())
  scriptId    String
  orderIndex  Int
  title       String
  duration    Int       @default(0) // seconds
  description String?
  dialogue    String?
  characters  String[]  // character IDs or names
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  script      Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)
}

model Character {
  id          String         @id @default(cuid())
  userId      String
  name        String
  avatarUrl   String?
  role        CharacterRole  @default(MAIN)
  description String?
  personality String?
  notes       String?
  tags        String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scripts     ScriptCharacter[]
}

model ScriptCharacter {
  scriptId    String
  characterId String

  script      Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([scriptId, characterId])
}

model CalendarEvent {
  id            String        @id @default(cuid())
  userId        String
  videoId       String?
  title         String
  scheduledDate DateTime
  platform      VideoPlatform @default(YOUTUBE)
  status        VideoStatus   @default(SCHEDULED)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  video         Video?        @relation(fields: [videoId], references: [id], onDelete: SetNull)
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  theme               String   @default("dark")
  emailNotifications  Boolean  @default(true)
  browserNotifications Boolean @default(true)
  defaultPlatform     VideoPlatform @default(YOUTUBE)
  connectedYoutube    Boolean  @default(false)
  connectedTiktok     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
