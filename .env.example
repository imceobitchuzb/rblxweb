# ==============================================================================
# ROXIE HUB Environment Configuration
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (Prisma + PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roxie_hub?schema=public"

# Authentication & Multi-Tenant Session
SESSION_SECRET="roxie-hub-secure-auth-jwt-secret-token-32-bytes-minimum"

# Platform API Integrations (Future integrations)
YOUTUBE_API_KEY=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# AI Assistant Integrations (Future integrations)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
